# Copy this file to .env and fill it in:  cp .env.example .env
# Never commit your .env. It contains your Letterboxd API secret.

# Your OWN Letterboxd API credentials. Letterboxd grants these case by case:
# request access at api@letterboxd.com (see the README).
LETTERBOXD_CLIENT_ID=
LETTERBOXD_CLIENT_SECRET=

# The address you open the dashboard at. The Letterboxd sign-in sends you back to
# PUBLIC_URL/letterboxd/callback, so register that exact URL with Letterboxd.
PUBLIC_URL=http://192.168.1.50:8977

# Your time zone, so diary dates match the day you actually watched.
TZ=America/New_York

# Optional: password-protect the dashboard (any username works in the browser prompt).
UI_PASSWORD=

# Optional
PORT=8977
LOG_LEVEL=info
